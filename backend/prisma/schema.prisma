generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   // ADMIN, GESTOR_ARMARIA, OPERADOR, AUDITOR
  active    Boolean  @default(true)
  tokenVersion Int   @default(0)
  preferences Json   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  movements Movement[]
  auditLogs AuditLog[]
  notificationReads NotificationRead[]
}

model Armament {
  id                 String   @id @default(uuid())
  tipo               String   // Ex: Pistola, Fuzil
  marca              String
  modelo             String
  calibre            String
  numSerie           String   @unique
  numRegistro        String   @unique
  dataAquisicao      DateTime
  status             String   @default("ESTOQUE") // ESTOQUE, USO, MANUTENCAO, BLOQUEADA, BAIXADA
  local              String
  observacoes        String?
  dataManutencao     DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  movements Movement[]
}

model Ammunition {
  id          String   @id @default(uuid())
  tipo        String
  calibre     String
  quantidade  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  movements Movement[]
}

model Responsible {
  id                     String   @id @default(uuid())
  nome                   String
  identificacaoFuncional String   @unique
  setor                  String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  movements Movement[]
}

model Vest {
  id                 String   @id @default(uuid())
  marca              String
  modelo             String
  tamanho            String
  nivelProtecao      String
  numSerie           String   @unique
  numPatrimonio      String   @unique
  dataAquisicao      DateTime
  dataFabricacao     DateTime?
  dataValidade       DateTime?
  dataManutencao     DateTime?
  local              String
  status             String   @default("ESTOQUE")
  observacoes        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  movements Movement[]
}

model Movement {
  id            String   @id @default(uuid())
  tipo          String   // RETIRADA, DEVOLUCAO, TRANSFERENCIA, MANUTENCAO
  data          DateTime @default(now())
  motivo        String?
  quantidade    Int?
  destino       String?
  
  armamentId    String?
  armament      Armament? @relation(fields: [armamentId], references: [id], onDelete: Restrict)
  
  ammunitionId  String?
  ammunition    Ammunition? @relation(fields: [ammunitionId], references: [id], onDelete: Restrict)

  vestId        String?
  vest          Vest? @relation(fields: [vestId], references: [id], onDelete: Restrict)
  
  responsibleId String?
  responsible   Responsible? @relation(fields: [responsibleId], references: [id], onDelete: Restrict)
  
  userId        String
  user          User      @relation(fields: [userId], references: [id])

  createdAt     DateTime @default(now())
  @@index([armamentId, data])
  @@index([vestId, data])
  @@index([ammunitionId, responsibleId])
  @@index([data])
}

model AuditLog {
  id        String   @id @default(uuid())
  acao      String   // Ex: Alteração de status, Novo cadastro
  detalhes  String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  data      DateTime @default(now())
  @@index([data])
}

model SystemSettings {
  id        String @id @default("global")
  data      Json @default("{}")
  updatedAt DateTime @updatedAt
}

model NotificationRead {
  userId String
  key String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt DateTime @default(now())
  @@id([userId, key])
}
